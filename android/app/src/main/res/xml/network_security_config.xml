<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo el backend de desarrollo habla por HTTP plano (emulador o localhost);
  todo lo demás sigue exigiendo HTTPS. Android bloquea el tráfico sin cifrar
  desde API 28, así que sin esta configuración la app no vería al backend
  local aunque esté corriendo en la misma máquina.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>